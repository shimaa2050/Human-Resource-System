     connectionString="Data Source=DELL-KL24Q0N\SQLEXPRESS; Initial Catalog=shimaa11818; Integrated Security=True"
     providerName="System.Data.SqlClient" />


		<!--<add name="shimaa11818"
			 connectionString="Data Source=SQL9001.site4now.net;Initial Catalog=db_ac5e59_shimaa11818;User Id=db_ac5e59_shimaa11818_admin;Password=Fatimaaali@642;Encrypt=True;TrustServerCertificate=True;"
			 providerName="System.Data.SqlClient" />-->

	</connectionStrings>

	<appSettings>
		<add key="workName" value="KFMC" />
		<add key="emailUserName" value="shoshita2050@gmail.com" />
		<add key="emailPassword" value="kobxpneybymroczs" />
		<add key="emailFrom" value="shoshita2050@gmail.com" />
		<add key="emailTo" value="shimaaalshabaan75@gmail.com" />
		<add key="HostsmtpAddress" value="smtp.gmail.com" />
		<add key="PortNumber" value="587" />
		<add key="EnableSSL" value="true" />
	</appSettings>

	<system.web>

		<compilation debug="true" targetFramework="4.7.2" />
		<httpRuntime targetFramework="4.7.2" />

		<!-- AUTHENTICATION -->
		<authentication mode="Forms">
			<forms name=".LoginCookie"
				   loginUrl="~/login.aspx"
				   timeout="40"
				   protection="All"
				   path="/" />
		</authentication>

		<!-- REQUIRE LOGIN FOR WHOLE SITE -->
	  <authorization>
		  <allow roles="user" />
		  <!--<deny users="*" />-->
		  <!-- means to force anyonymous users to login, means to prompt user for user name and password. -->
		  <deny users="xxx" />
		  <!--means to prevent specific users from loggin into the app,but still be able to log in, with no access to app menu-->
	  </authorization>

		<!-- ROLE MANAGER -->
		<roleManager enabled="true" defaultProvider="SqlRoleManager">
			<providers>
				<clear />
				<add name="SqlRoleManager"
					 type="System.Web.Security.SqlRoleProvider"
					 connectionStringName="shimaa11818"
					 applicationName="/shimaa11818WebApp" />
			</providers>
		</roleManager>

		<!-- MEMBERSHIP -->
		<membership defaultProvider="MyProviderWebhosting">
			<providers>
				<clear />
				<add name="MyProviderWebhosting"
					 type="System.Web.Security.SqlMembershipProvider"
					 connectionStringName="shimaa11818"
					 applicationName="/shimaa11818WebApp"
					 passwordFormat="Hashed"
					 minRequiredPasswordLength="3"
					 minRequiredNonalphanumericCharacters="0"
					 requiresQuestionAndAnswer="false"
					 requiresUniqueEmail="false"
					 enablePasswordReset="true"
					 maxInvalidPasswordAttempts="6"
					 passwordAttemptWindow="10" />
			</providers>
		</membership>

	</system.web>

	<!-- ADMIN SECURITY -->
	<location path="~/Admin_Pages">
		<system.web>
			<authorization>
				<allow roles="admin"/>
				<deny users="*"/>
			</authorization>
		</system.web>
	</location>

	<!-- HR SECURITY -->
	<location path="~/HR_Pages">
		<system.web>
			<authorization>
				<allow roles="HR"/>
				<deny users="*"/>
			</authorization>
		</system.web>
	</location>
	
	
	

	<runtime>
		<assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
			<dependentAssembly>
				<assemblyIdentity name="Antlr3.Runtime" publicKeyToken="eb42632606e9261f" />
				<bindingRedirect oldVersion="0.0.0.0-3.5.0.2" newVersion="3.5.0.2" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" />
				<bindingRedirect oldVersion="0.0.0.0-12.0.0.0" newVersion="12.0.0.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="WebGrease" publicKeyToken="31bf3856ad364e35" />
				<bindingRedirect oldVersion="0.0.0.0-1.6.5135.21930" newVersion="1.6.5135.21930" />
			</dependentAssembly>
		</assemblyBinding>
	</runtime>

</configuration>